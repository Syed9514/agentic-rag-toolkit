# .env.example

# Application settings
APP_NAME=Agentic RAG Toolkit
API_PREFIX=/api

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
VECTORSTORE_PATH=.vectorstore
DOCS_PATH=docs
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
LOG_LEVEL=INFO
